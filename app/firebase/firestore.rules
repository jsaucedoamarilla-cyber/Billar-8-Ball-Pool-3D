rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function notBanned() {
      return signedIn() && !exists(/databases/$(database)/documents/banned/$(request.auth.uid));
    }
    function owner(id) { return notBanned() && request.auth.uid == id; }
    function optStr(d, k, n) { return !(k in d) || (d[k] is string && d[k].size() <= n); }
    function isPlayer(room) {
      let r = get(/databases/$(database)/documents/rooms/$(room)).data;
      return r.h.u == request.auth.uid || (('g' in r) && r.g.u == request.auth.uid);
    }

    // Lista de baneados: solo se edita desde la consola de Firebase (que ignora las reglas).
    match /banned/{id} { allow read, write: if false; }

    // Reportes de jugadores: solo se crean; se leen desde la consola.
    match /reports/{id} {
      allow create: if notBanned()
        && request.resource.data.by == request.auth.uid
        && request.resource.data.keys().hasOnly(['by','target','name','room','motivo','t'])
        && optStr(request.resource.data, 'motivo', 20)
        && optStr(request.resource.data, 'name', 30);
      allow read, update, delete: if false;
    }

    // Salas de partida
    match /rooms/{room} {
      allow read: if notBanned();
      allow create: if notBanned() && request.resource.data.h.u == request.auth.uid;
      allow update: if notBanned() && (
        // anfitrión o invitado ya dentro de la sala
        resource.data.h.u == request.auth.uid
        || (('g' in resource.data) && resource.data.g.u == request.auth.uid)
        // unirse a una sala libre
        || (!('g' in resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['g','st0'])
            && request.resource.data.g.u == request.auth.uid)
      );
      allow delete: if notBanned() && resource.data.h.u == request.auth.uid;

      match /chat/{id} {
        allow read: if notBanned();
        allow create: if notBanned() && optStr(request.resource.data, 'm', 100) && optStr(request.resource.data, 'n', 30);
        allow update, delete: if false;
      }
      match /gifts/{id} {
        allow read: if notBanned();
        allow create: if notBanned();
        allow update, delete: if false;
      }
      match /spectators/{id} {
        allow read: if notBanned();
        allow create, update: if owner(id)
          && request.resource.data.keys().hasOnly(['n','t','favorite'])
          && request.resource.data.keys().hasAll(['n','t','favorite'])
          && request.resource.data.n is string
          && request.resource.data.n.size() <= 30
          && request.resource.data.t is number
          && (request.resource.data.favorite == null
              || request.resource.data.favorite == 0
              || request.resource.data.favorite == 1);
        allow delete: if owner(id);
      }
      // Señalización WebRTC: solo los dos jugadores de esta sala pueden leerla.
      match /voice/{uid} {
        allow read: if notBanned() && isPlayer(room);
        allow create, update: if owner(uid) && isPlayer(room)
          && request.resource.data.keys().hasOnly(['name','role','startedAt','offer','answer'])
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 30
          && request.resource.data.role in ['host','guest'];
        allow delete: if owner(uid) && isPlayer(room);
        match /candidates/{candidateId} {
          allow read: if notBanned() && isPlayer(room);
          allow create: if owner(uid) && isPlayer(room)
            && request.resource.data.keys().hasOnly(['candidate','sdpMid','sdpMLineIndex','usernameFragment'])
            && request.resource.data.candidate is string;
          allow update: if false;
          allow delete: if owner(uid) && isPlayer(room);
        }
      }
      match /replay/{id} {
        allow read: if notBanned();
        allow write: if notBanned() && isPlayer(room);
      }
    }
    // Consulta global de regalos (collectionGroup)
    match /{path=**}/gifts/{id} { allow read: if notBanned(); }

    // Datos por jugador: lectura para jugadores autenticados (rankings), escritura solo del dueño
    match /elo/{id}              { allow read: if notBanned(); allow write: if owner(id); }
    match /spectator_rank/{id}   { allow read: if notBanned(); allow write: if owner(id); }
    match /spectator_stats/{id}  { allow read: if notBanned(); allow write: if owner(id); }
    match /spectator_weekly/{w}/top/{id} { allow read: if notBanned(); allow write: if owner(id); }
    match /taco_masters/{id}     { allow read: if notBanned(); allow write: if owner(id); }
    match /fr/{id}               { allow read: if notBanned(); allow write: if owner(id); }
    match /data/users/{id}/{doc=**} { allow read, write: if owner(id); }

    match /notificaciones/{id}/cola/{n} {
      allow create: if notBanned();
      allow read, delete: if owner(id);
      allow update: if false;
    }

    // Clanes y torneos (reglas amplias: ver README, sección "Límites")
    match /clanes/{c} {
      allow read: if notBanned();
      allow create: if notBanned() && optStr(request.resource.data, 'n', 24);
      allow update: if notBanned();
      allow delete: if false;
    }
    match /torneos_suizos/{t}      { allow read, create, update: if notBanned(); }
    match /torneos_espectables/{t} { allow read, create, update: if notBanned(); }


    // Amigos: cada jugador administra únicamente su propia lista.
    match /friends/{uid}/list/{friendUid} {
      allow read, create, update, delete: if owner(uid);
    }
    // Solicitudes: solo quien las envía puede crear; solo destinatario puede aceptar/rechazar.
    match /friend_requests/{requestId} {
      allow create: if notBanned()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['from','to','fromName','toName','status','createdAt']);
      allow read: if notBanned()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow update: if notBanned()
        && resource.data.to == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','acceptedAt'])
        && request.resource.data.status in ['accepted','rejected'];
      allow delete: if false;
    }
    // Torneos: inscripción abierta, cruces creados por el organizador.
    match /tournaments/{tid} {
      allow read: if notBanned();
      allow create: if notBanned()
        && request.resource.data.creatorUid == request.auth.uid
        && request.resource.data.uids is list
        && request.resource.data.uids.hasAny([request.auth.uid]);
      allow update: if notBanned() && (
        resource.data.creatorUid == request.auth.uid
        || (resource.data.status == 'registration'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uids'])
          && request.resource.data.uids.hasAll(resource.data.uids)
          && request.resource.data.uids.hasAny([request.auth.uid])
          && request.resource.data.uids.size() <= resource.data.maxPlayers)
      );
      allow delete: if false;
      match /members/{uid} {
        allow read: if notBanned();
        allow create: if owner(uid)
          && get(/databases/$(database)/documents/tournaments/$(tid)).data.status == 'registration'
          && request.resource.data.keys().hasOnly(['uid','name','joinedAt'])
          && request.resource.data.uid == request.auth.uid;
        allow update, delete: if false;
      }
      match /matches/{mid} {
        function isMatchPlayer() {
          return notBanned() && (resource.data.aUid == request.auth.uid || resource.data.bUid == request.auth.uid);
        }
        allow read: if notBanned();
        allow create: if notBanned()
          && get(/databases/$(database)/documents/tournaments/$(tid)).data.creatorUid == request.auth.uid;
        allow update: if isMatchPlayer()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['winnerUid','status','confirmedAt'])
          && exists(/databases/$(database)/documents/tournaments/$(tid)/matches/$(mid)/reports/$(resource.data.aUid))
          && exists(/databases/$(database)/documents/tournaments/$(tid)/matches/$(mid)/reports/$(resource.data.bUid))
          && get(/databases/$(database)/documents/tournaments/$(tid)/matches/$(mid)/reports/$(resource.data.aUid)).data.winnerUid == request.resource.data.winnerUid
          && get(/databases/$(database)/documents/tournaments/$(tid)/matches/$(mid)/reports/$(resource.data.bUid)).data.winnerUid == request.resource.data.winnerUid;
        allow delete: if false;
        match /reports/{uid} {
          allow read: if notBanned()
            && (get(/databases/$(database)/documents/tournaments/$(tid)/matches/$(mid)).data.aUid == request.auth.uid
              || get(/databases/$(database)/documents/tournaments/$(tid)/matches/$(mid)).data.bUid == request.auth.uid);
          allow create: if owner(uid)
            && (get(/databases/$(database)/documents/tournaments/$(tid)/matches/$(mid)).data.aUid == request.auth.uid
              || get(/databases/$(database)/documents/tournaments/$(tid)/matches/$(mid)).data.bUid == request.auth.uid)
            && request.resource.data.keys().hasOnly(['winnerUid','reportedAt'])
            && request.resource.data.winnerUid is string;
          allow update, delete: if false;
        }
      }
    }

    // Todo lo demás: denegado
    match /{document=**} { allow read, write: if false; }
  }
}
