rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function notBanned() {
      return signedIn() &&
        !exists(/databases/$(database)/documents/banned/$(request.auth.uid));
    }
    function owner(id) { return notBanned() && request.auth.uid == id; }
    function optStr(d, k, s) {
      return !(k in d) || (d[k] is string && s >= d[k].size());
    }
    function isPlayer(room) {
      let r = get(/databases/$(database)/documents/rooms/$(room)).data;
      return r.h.u == request.auth.uid ||
        (('g' in r) && r.g.u == request.auth.uid);
    }

    // El propietario crea admins/{UID} manualmente desde Firebase Console.
    // Los clientes solo pueden consultar su propio documento; nunca asignarse roles.
    match /admins/{id} {
      allow get: if signedIn() && request.auth.uid == id;
      allow list, create, update, delete: if false;
    }

    // Configuración global de las guías de puntería: lectura para jugadores autenticados,
    // escritura exclusiva del administrador. El cliente compara expiresAt con la hora actual.
    match /aim_control/{id} {
      allow get: if signedIn() && id == 'global';
      allow list: if false;
      allow create, update, delete: if isAdmin() && id == 'global';
    }

    match /banned/{id} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == id);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /reports/{id} {
      allow create: if notBanned() &&
        request.resource.data.by == request.auth.uid &&
        request.resource.data.keys().hasOnly(['by','target','name','room','motivo','t']) &&
        optStr(request.resource.data, 'motivo', 20) &&
        optStr(request.resource.data, 'name', 30);
      allow read, update, delete: if isAdmin();
    }

    match /rooms/{room} {
      allow read: if notBanned() || isAdmin();
      allow create: if notBanned() && request.resource.data.h.u == request.auth.uid;
      allow update: if notBanned() &&
        (resource.data.h.u == request.auth.uid ||
         (('g' in resource.data) && resource.data.g.u == request.auth.uid) ||
         (!('g' in resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['g','st0']) &&
          request.resource.data.g.u == request.auth.uid));
      allow delete: if notBanned() && resource.data.h.u == request.auth.uid;

      match /chat/{id} {
        allow read: if notBanned();
        allow create: if notBanned() &&
          optStr(request.resource.data, 'm', 100) &&
          optStr(request.resource.data, 'n', 30);
        allow update, delete: if false;
      }

      match /gifts/{id} {
        allow read: if notBanned();
        allow create: if notBanned();
        allow update, delete: if false;
      }

      match /spectators/{id} {
        allow read, write: if notBanned();
      }

      match /replay/{id} {
        allow read: if notBanned();
        allow write: if notBanned() && isPlayer(room);
      }
    }

    match /{path=**}/gifts/{id} {
      allow read: if notBanned();
    }

    match /elo/{id} {
      allow read: if notBanned();
      allow write: if owner(id);
    }

    match /spectator_rank/{id} {
      allow read: if notBanned();
      allow write: if owner(id);
    }

    match /spectator_stats/{id} {
      allow read: if notBanned();
      allow write: if owner(id);
    }

    match /spectator_weekly/{w}/top/{id} {
      allow read: if notBanned();
      allow write: if owner(id);
    }

    match /taco_masters/{id} {
      allow read: if notBanned();
      allow write: if owner(id);
    }

    match /fr/{id} {
      allow read: if notBanned();
      allow write: if owner(id);
    }

    // Índice mínimo de jugadores: cada cuenta solo escribe su propio documento;
    // únicamente el administrador puede consultar la colección completa.
    match /admin_player_index/{id} {
      allow read: if isAdmin();
      allow create, update, delete: if owner(id);
    }

    match /data/users/{id}/{doc=**} {
      allow read: if owner(id) || isAdmin();
      allow write: if owner(id);
    }

    match /notificaciones/{id}/cola/{s} {
      allow create: if notBanned() || isAdmin();
      allow read, delete: if signedIn() && request.auth.uid == id;
      allow update: if false;
    }

    match /moderation/{uid} {
      allow read: if isAdmin() || owner(uid);
      allow create, update: if isAdmin();
      allow delete: if false;
      match /events/{eventId} {
        allow read: if isAdmin() || owner(uid);
        allow create: if isAdmin();
        allow update, delete: if false;
      }
    }

    match /clanes/{c} {
      allow read: if notBanned();
      allow create: if notBanned() && optStr(request.resource.data, 'n', 24);
      allow update: if notBanned();
      allow delete: if false;
    }

    match /torneos_suizos/{t} {
      allow read, create, update: if notBanned();
    }

    match /torneos_espectables/{t} {
      allow read, create, update: if notBanned();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}